<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OH MY LEO</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', sans-serif; }
        body {
            /* BURAYA DİKKAT: 'arka.jpg' kısmına yüklediğin resmin tam adını yaz */
            background: linear-gradient(rgba(0, 0, 0, 0.75), rgba(0, 0, 0, 0.75)), url('arka.jpg') center/cover no-repeat fixed;
            color: #fff;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
        nav { display: flex; justify-content: space-between; align-items: center; padding: 25px 50px; }
        .logo { font-weight: bold; letter-spacing: 2px; }
        .nav-links a { color: #ccc; text-decoration: none; margin: 0 15px; font-size: 14px; }
        .hero { text-align: center; padding: 40px 20px; }
        .hero h1 { font-size: 42px; letter-spacing: 5px; line-height: 1.3; font-family: serif; }
        .subtitle { color: #aaa; letter-spacing: 3px; font-size: 12px; margin-top: 15px; }
        .cards { display: flex; justify-content: center; gap: 20px; flex-wrap: wrap; margin-top: 40px; }
        .card {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            padding: 20px 30px;
            border-radius: 12px;
            width: 180px;
            text-align: center;
        }
        .card i { font-size: 28px; margin-bottom: 10px; }
        .card h3 { font-size: 12px; letter-spacing: 1px; color: #888; }
        .card p { font-size: 14px; margin-top: 5px; }
    </style>
</head>
<body>
    <nav>
        <div class="logo">🦁 OH MY LEO</div>
        <div class="nav-links">
            <a href="#">ANA SAYFA</a>
            <a href="#">HAKKIMDA</a>
            <a href="#">GALERİ</a>
            <a href="#">İLETİŞİM</a>
        </div>
    </nav>

    <div class="hero">
        <h1>BURASI<br>LEONARDONUN<br>DÜNYASI</h1>
        <p class="subtitle">KENDİ KURALLARIM, KENDİ DÜNYAM.</p>

        <div class="cards">
            <div class="card"><i class="fab fa-discord"></i><h3>DISCORD</h3><p>lostle0</p></div>
            <div class="card"><i class="fab fa-tiktok"></i><h3>TIKTOK</h3><p>19leonardo4</p></div>
            <div class="card"><i class="fas fa-envelope"></i><h3>E-MAIL</h3><p>lostleox111</p></div>
            <div class="card"><i class="fas fa-phone"></i><h3>TELEFON</h3><p>05xx xxx xx xx</p></div>
        </div>
    </div>
    <div></div>
</body>
</html>

